{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rachi",
  "main": "src/index.js",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "routes": [
    "rachi.ao/*",
    "www.rachi.ao/*",
    "admin.rachi.ao/*",
    "api.rachi.ao/*"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rachi-db",
      "database_id": "3d45fd42-a83d-44fa-a3f9-c50e01746538"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "staging": {
      "name": "rachi-staging",
      "workers_dev": true,
      "routes": [],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "rachi-db-staging",
          "database_id": "902a75e4-bbb5-493b-97aa-46afd39b353a"
        }
      ],
      "ai": {
        "binding": "AI"
      }
    },
    "production": {
      "name": "rachi",
      "workers_dev": true,
      "routes": [
        "rachi.ao/*",
        "www.rachi.ao/*",
        "admin.rachi.ao/*",
        "api.rachi.ao/*"
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "rachi-db",
          "database_id": "3d45fd42-a83d-44fa-a3f9-c50e01746538"
        }
      ],
      "ai": {
        "binding": "AI"
      }
    }
  }
}
