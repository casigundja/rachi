{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "rachi",
    "account_id": "e8c87d3bd3a989eb8dcd12bfd52e97a6",
    "main": "deploy/worker.js",
    "compatibility_date": "2026-09-24",
    "workers_dev": true,
    "observability": { "enabled": true },
    "containers": [{
        "class_name": "RachiContainer",
        "image": "./Dockerfile",
        "max_instances": 1,
        "instance_type": "basic"
    }],
    "durable_objects": {
        "bindings": [{ "name": "RACHI", "class_name": "RachiContainer" }]
    },
    "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RachiContainer"] }]
}
